<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Activities Dashboard Category -->
        <record id="module_category_activities_dashboard" model="ir.module.category">
            <field name="name">Activities Dashboard</field>
            <field name="description">Access rights for Activities Dashboard module</field>
            <field name="sequence">100</field>
        </record>

        <!-- User Group -->
        <record id="group_activities_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_activities_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group -->
        <record id="group_activities_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_activities_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('group_activities_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
