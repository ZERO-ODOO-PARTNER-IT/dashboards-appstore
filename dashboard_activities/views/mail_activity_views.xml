<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mail Activity List View -->
    <record id="mail_activity_view_list" model="ir.ui.view">
        <field name="name">mail.activity.view.list.dashboard</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <list string="Activities" default_order="date_deadline asc" decoration-danger="date_deadline &lt; current_date" decoration-warning="date_deadline == current_date" decoration-success="date_deadline &gt; current_date">
                <field name="activity_type_id"/>
                <field name="summary"/>
                <field name="res_model_id"/>
                <field name="res_name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_deadline"/>
                <field name="state" widget="badge" decoration-danger="state == 'overdue'" decoration-warning="state == 'today'" decoration-success="state == 'planned'"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid" optional="hide" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- Mail Activity Form View -->
    <record id="mail_activity_view_form" model="ir.ui.view">
        <field name="name">mail.activity.view.form.dashboard</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <form string="Activity">
                <sheet>
                    <div class="oe_title">
                        <label for="summary"/>
                        <h1>
                            <field name="summary" placeholder="e.g. Discuss proposal"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="activity_type_id" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_deadline"/>
                            <field name="state" widget="badge" decoration-danger="state == 'overdue'" decoration-warning="state == 'today'" decoration-success="state == 'planned'"/>
                        </group>
                        <group>
                            <field name="res_model_id" readonly="1"/>
                            <field name="res_name" readonly="1"/>
                            <field name="create_uid" readonly="1" widget="many2one_avatar_user"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Add notes here..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Mail Activity Kanban View -->
    <record id="mail_activity_view_kanban" model="ir.ui.view">
        <field name="name">mail.activity.view.kanban.dashboard</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="activity_type_id" class="o_kanban_small_column" sample="1">
                <field name="activity_type_id"/>
                <field name="summary"/>
                <field name="user_id"/>
                <field name="date_deadline"/>
                <field name="state"/>
                <field name="res_name"/>
                <field name="color"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="d-flex flex-column gap-1">
                            <field name="user_id" widget="many2one_avatar_user" class="d-block" readonly="1"/>
                        </aside>
                        <main class="ms-2">
                            <field name="summary" class="fw-bold d-block text-truncate"/>
                            <field name="res_name" class="text-muted small"/>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <field name="date_deadline" widget="remaining_days"/>
                                <field name="state" widget="badge" decoration-danger="state == 'overdue'" decoration-warning="state == 'today'" decoration-success="state == 'planned'"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Mail Activity Calendar View -->
    <record id="mail_activity_view_calendar" model="ir.ui.view">
        <field name="name">mail.activity.view.calendar.dashboard</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <calendar string="Activities Calendar" date_start="date_deadline" color="activity_type_id" mode="month" quick_create="0" event_limit="5">
                <field name="summary"/>
                <field name="activity_type_id" filters="1"/>
                <field name="user_id" widget="many2one_avatar_user" filters="1"/>
                <field name="res_name"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Mail Activity Search View -->
    <record id="mail_activity_view_search" model="ir.ui.view">
        <field name="name">mail.activity.view.search.dashboard</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <search string="Search Activities">
                <field name="summary"/>
                <field name="activity_type_id"/>
                <field name="user_id"/>
                <field name="res_model_id"/>
                <field name="res_name"/>
                <separator/>
                <filter string="My Activities" name="my_activities" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Overdue" name="overdue" domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Today" name="today" domain="[('date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Planned" name="planned" domain="[('date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="This Week" name="this_week" domain="[('date_deadline', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('date_deadline', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('date_deadline', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Assigned To" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Activity Type" name="group_type" context="{'group_by': 'activity_type_id'}"/>
                    <filter string="Document Model" name="group_model" context="{'group_by': 'res_model_id'}"/>
                    <filter string="Deadline" name="group_deadline" context="{'group_by': 'date_deadline:day'}"/>
                    <filter string="Deadline Month" name="group_deadline_month" context="{'group_by': 'date_deadline:month'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Mail Activity Pivot View -->
    <record id="mail_activity_view_pivot" model="ir.ui.view">
        <field name="name">mail.activity.view.pivot.dashboard</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <pivot string="Activities Analysis" sample="1">
                <field name="activity_type_id" type="row"/>
                <field name="user_id" type="col"/>
                <field name="id" type="measure" string="Count"/>
            </pivot>
        </field>
    </record>

    <!-- Mail Activity Graph View -->
    <record id="mail_activity_view_graph" model="ir.ui.view">
        <field name="name">mail.activity.view.graph.dashboard</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <graph string="Activities Analysis" type="bar" sample="1">
                <field name="activity_type_id"/>
                <field name="id" type="measure" string="Count"/>
            </graph>
        </field>
    </record>

    <!-- Mail Activity Action -->
    <record id="mail_activity_action" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban,calendar,form,pivot,graph</field>
        <field name="search_view_id" ref="mail_activity_view_search"/>
        <field name="context">{'search_default_my_activities': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No activities found
            </p>
            <p>
                Activities help you plan and track tasks related to records in Odoo.
            </p>
        </field>
    </record>

    <!-- View Sequence -->
    <record id="mail_activity_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mail_activity_view_list"/>
        <field name="act_window_id" ref="mail_activity_action"/>
    </record>

    <record id="mail_activity_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="mail_activity_view_kanban"/>
        <field name="act_window_id" ref="mail_activity_action"/>
    </record>

    <record id="mail_activity_action_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="mail_activity_view_calendar"/>
        <field name="act_window_id" ref="mail_activity_action"/>
    </record>

    <record id="mail_activity_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mail_activity_view_form"/>
        <field name="act_window_id" ref="mail_activity_action"/>
    </record>

    <record id="mail_activity_action_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="mail_activity_view_pivot"/>
        <field name="act_window_id" ref="mail_activity_action"/>
    </record>

    <record id="mail_activity_action_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="6"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="mail_activity_view_graph"/>
        <field name="act_window_id" ref="mail_activity_action"/>
    </record>
</odoo>
