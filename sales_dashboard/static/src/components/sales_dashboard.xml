<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sales_dashboard.SalesDashboard">
        <div class="o_sales_dashboard">
            <div class="container-fluid py-4">
                <!-- Header -->
                <div class="row mb-4">
                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <h1 class="mb-0">
                            <i class="fa fa-dashboard me-2"/>Sales Dashboard
                        </h1>
                        <button class="btn btn-primary" t-on-click="onRefresh">
                            <i class="fa fa-refresh me-1"/>Refresh
                        </button>
                    </div>
                </div>

                <!-- Loading State -->
                <t t-if="state.isLoading">
                    <div class="row">
                        <div class="col-12 text-center py-5">
                            <i class="fa fa-spinner fa-spin fa-3x"/>
                            <p class="mt-3">Loading dashboard data...</p>
                        </div>
                    </div>
                </t>

                <!-- Dashboard Content -->
                <t t-else="">
                    <!-- KPI Cards Row -->
                    <div class="row g-4 mb-4">
                        <!-- Total Sales -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                                <i class="fa fa-dollar fa-2x text-primary"/>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="text-muted mb-1">Total Sales</h6>
                                            <h3 class="mb-0">
                                                <t t-esc="formatCurrency(state.dashboardData?.total_sales || 0)"/>
                                            </h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Total Orders -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                                <i class="fa fa-shopping-cart fa-2x text-success"/>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="text-muted mb-1">Total Orders</h6>
                                            <h3 class="mb-0">
                                                <t t-esc="state.dashboardData?.total_orders || 0"/>
                                            </h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Average Order Value -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <div class="rounded-circle bg-info bg-opacity-10 p-3">
                                                <i class="fa fa-line-chart fa-2x text-info"/>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="text-muted mb-1">Avg Order Value</h6>
                                            <h3 class="mb-0">
                                                <t t-esc="formatCurrency(state.dashboardData?.avg_order_value || 0)"/>
                                            </h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Total Quantity Sold -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                                                <i class="fa fa-cubes fa-2x text-warning"/>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="text-muted mb-1">Qty Sold</h6>
                                            <h3 class="mb-0">
                                                <t t-esc="state.dashboardData?.total_qty_sold || 0"/>
                                            </h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Second Row: Orders by State and Top Products -->
                    <div class="row g-4 mb-4">
                        <!-- Orders by State -->
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-header bg-transparent border-0">
                                    <h5 class="mb-0">
                                        <i class="fa fa-pie-chart me-2"/>Orders by Status
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <t t-if="state.dashboardData?.orders_by_state">
                                        <t t-foreach="Object.entries(state.dashboardData.orders_by_state)" t-as="entry" t-key="entry[0]">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <span>
                                                    <span t-attf-class="badge me-2 {{ getStateBadgeClass(entry[0]) }}">
                                                        <t t-esc="getStateLabel(entry[0])"/>
                                                    </span>
                                                </span>
                                                <span class="fw-bold">
                                                    <t t-esc="entry[1]"/>
                                                </span>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center">No data available</p>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Top Selling Products -->
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-header bg-transparent border-0">
                                    <h5 class="mb-0">
                                        <i class="fa fa-trophy me-2"/>Top Selling Products
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <t t-if="state.dashboardData?.top_products?.length">
                                        <t t-foreach="state.dashboardData.top_products" t-as="product" t-key="product.name">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <span class="text-truncate" style="max-width: 60%;">
                                                    <i class="fa fa-cube me-2 text-muted"/>
                                                    <t t-esc="product.name"/>
                                                </span>
                                                <span class="badge bg-success">
                                                    <t t-esc="formatCurrency(product.amount)"/>
                                                </span>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center">No products sold yet</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Orders Table -->
                    <div class="row g-4">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <i class="fa fa-list me-2"/>Recent Orders
                                    </h5>
                                    <button class="btn btn-outline-primary btn-sm" t-on-click="viewSaleOrders">
                                        View All Orders
                                    </button>
                                </div>
                                <div class="card-body">
                                    <t t-if="state.dashboardData?.recent_orders?.length">
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Order</th>
                                                        <th>Customer</th>
                                                        <th>Date</th>
                                                        <th>Amount</th>
                                                        <th>Status</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="state.dashboardData.recent_orders" t-as="order" t-key="order.id">
                                                        <tr>
                                                            <td>
                                                                <a href="#" t-on-click.prevent="() => this.viewOrder(order.id)">
                                                                    <t t-esc="order.name"/>
                                                                </a>
                                                            </td>
                                                            <td><t t-esc="order.partner"/></td>
                                                            <td><t t-esc="order.date"/></td>
                                                            <td><t t-esc="formatCurrency(order.amount)"/></td>
                                                            <td>
                                                                <span t-attf-class="badge {{ getStateBadgeClass(order.state) }}">
                                                                    <t t-esc="getStateLabel(order.state)"/>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <button
                                                                    class="btn btn-sm btn-outline-primary"
                                                                    t-on-click="() => this.viewOrder(order.id)">
                                                                    <i class="fa fa-eye"/>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted text-center py-4">No orders found</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
